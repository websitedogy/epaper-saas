APP_NAME="Dogy ePaper SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.dogyepaper.com
APP_FRONTEND_URL=https://dogyepaper.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=epaper_saas
DB_USERNAME=epaper
DB_PASSWORD=
# Only used by docker-compose to create the MySQL container.
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.dogyepaper.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=dogy-epaper-cache-

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_MAX_RETRIES=3

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=websitedogy@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="websitedogy@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_BACKUP_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_EDITIONS_PREFIX=editions
AWS_BACKUPS_PREFIX=backups

EDITION_DISK=local
# For S3 editions run: composer require league/flysystem-aws-s3-v3
# then set EDITION_DISK=s3 and AWS_* below.
EDITION_GHOSTSCRIPT_BINARY=gs
BACKUP_DRIVER=local
BACKUP_KEEP=14
BACKUP_DAILY_AT=02:15
BACKUP_ALERT_EMAIL=

DOMAIN_SERVER_IP=
DOMAIN_SERVER_IPS=
DOMAIN_CANONICAL_HOST=dogyepaper.com
DOMAIN_WILDCARD_BASE=dogyepaper.com
DOMAIN_CNAME_TARGET=tenants.dogyepaper.com
DOMAIN_CENTRAL_HOSTS=dogyepaper.com,www.dogyepaper.com,api.dogyepaper.com
DOMAIN_FRONTEND_HOSTS=dogyepaper.com,www.dogyepaper.com
DOMAIN_SSL_AUTO_PROVISION=true
DOMAIN_SSL_PROVIDER=caddy
DOMAIN_SSL_COMMAND=
DOMAIN_SSL_EMAIL=ops@dogyepaper.com
DOMAIN_TLS_ASK_TOKEN=

SERVER_APP_HOST=api.dogyepaper.com
SERVER_APP_IP=
SERVER_WORKER_HOST=
SERVER_WORKER_IP=
SERVER_FRONTEND_HOST=dogyepaper.com
SERVER_FRONTEND_IP=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

VITE_APP_NAME="${APP_NAME}"
